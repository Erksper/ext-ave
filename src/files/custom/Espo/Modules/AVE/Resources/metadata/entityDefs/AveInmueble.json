{
    "fields": {
        "name": {
            "type": "varchar",
            "required": false
        },
        "referencia": {
            "type": "varchar",
            "maxLength": 50,
            "unique": true
        },
        "nombrePropietario": {
            "type": "varchar",
            "maxLength": 255,
            "required": true
        },
        "tipoPropiedad": {
            "type": "enum",
            "options": ["habitacional", "comercial", "industrial", "vacacional", "terreno"]
        },
        "subtipoPropiedad": {
            "type": "enum",
            "options": ["departamento", "casa", "town-house", "terreno", "edificio", "oficinas", "local", "galpon", "penthouse", "hacienda", "deposito", "hotel-posada", "fondo-de-comercio", "negocio", "casa-bote", "clinica", "fabrica", "finca", "club", "tiempo-compartido", "nave", "casa-duplex", "quinta", "bodega", "inmueble-productivo", "rancho", "fraccionamiento"]
        },
        "estado": {
            "type": "varchar",
            "maxLength": 100
        },
        "municipio": {
            "type": "varchar",
            "maxLength": 100
        },
        "parroquia": {
            "type": "varchar",
            "maxLength": 100
        },
        "ciudad": {
            "type": "varchar",
            "maxLength": 100
        },
        "avenidaCalle": {
            "type": "varchar",
            "maxLength": 255
        },
        "edificioCasa": {
            "type": "varchar",
            "maxLength": 255
        },
        "urbanizacion": {
            "type": "varchar",
            "maxLength": 255
        },
        "areaConstruida": {
            "type": "float"
        },
        "areaTerreno": {
            "type": "float"
        },
        "antiguedad": {
            "type": "int"
        },
        "numHabitaciones": {
            "type": "float"
        },
        "numBanos": {
            "type": "float"
        },
        "puestoEstacionamiento": {
            "type": "int"
        },
        "piso": {
            "type": "varchar",
            "maxLength": 20
        },
        "ascensores": {
            "type": "bool",
            "default": false
        },
        "servicios": {
            "type": "enum",
            "options": ["completos", "basicos"]
        },
        "terraza": {
            "type": "bool",
            "default": false
        },
        "seguridad": {
            "type": "enum",
            "options": ["Vigilancia 24H", "Cerco", "Camaras", "Otro"]
        },
        "descripcion": {
            "type": "text"
        },
        "foto": {
            "type": "image"
        }
    },
    "links": {
        "avePrincipales": {
            "type": "hasMany",
            "entity": "AvePrincipal",
            "foreign": "aveInmueble"
        }
    },
    "collection": {
        "orderBy": "createdAt",
        "order": "desc"
    }
}